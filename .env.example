# Copy to .env for local testing. On Netlify, add these under
# Site configuration → Environment variables. NEVER commit a real .env file.

# --- Admin dashboard (/admin) ---
ADMIN_PASSWORD=change-me-to-something-long

# --- Square (Developer Dashboard → your app → Credentials) ---
# Start with sandbox to test, then switch to production.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhooks → Add subscription → URL: https://YOUR-SITE/api/square-webhook → events: payment.updated
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Optional: only if your webhook URL differs from SITE_URL + /api/square-webhook
SQUARE_WEBHOOK_URL=
SUPPORT_EMAIL=

# --- Optional day-one fallback: Square payment links made by hand in the Square Dashboard ---
# Used only when the API keys above are empty.
SQUARE_LINK_BLUEPRINT=
SQUARE_LINK_PROTOTYPE=
SQUARE_LINK_PLUS=

# --- Optional: AI concept drafts in the homepage builder (falls back to instant concepts) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Optional: force canonical site URL (Netlify sets URL automatically) ---
SITE_URL=
